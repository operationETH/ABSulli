# ABSulli advanced config
#
# Most users should use the web setup wizard instead.
# Only uncomment/set these when you specifically want env managed settings.

ABSULLI_HOST=0.0.0.0
ABSULLI_PORT=8272
ABSULLI_DATA_DIR=/config
ABSULLI_APP_NAME=ABSulli
ABSULLI_PUBLIC_URL=

# Audiobookshelf
# If ABS_URL or ABS_API_KEY are set, the setup wizard treats them as env managed/read-only.
ABS_URL=
ABS_API_KEY=
ABS_VERIFY_SSL=true
ABS_REQUEST_TIMEOUT=15
ABS_POLL_INTERVAL=15
ABS_HISTORY_POLL_INTERVAL=300
ABS_HISTORY_LOOKBACK_DAYS=30

# Optional notifications
GOTIFY_URL=
GOTIFY_TOKEN=
WEBHOOK_URL=

# Optional safety
ABSULLI_LOG_LEVEL=INFO
ABSULLI_SECRET_KEY=
ABSULLI_SECURITY_CSP_ENABLED=true

# Enable only when serving ABSulli directly over HTTPS.
ABSULLI_SECURITY_HSTS_ENABLED=false
ABSULLI_SECURITY_HSTS_MAX_AGE_SECONDS=31536000
ABSULLI_SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
ABSULLI_SECURITY_HSTS_PRELOAD=false

# Optional bearer token for /metrics.
ABSULLI_METRICS_TOKEN=

# Built-in login
ABSULLI_AUTH_ENABLED=true
ABSULLI_AUTH_USERNAME=admin

# Optional env managed admin password.
ABSULLI_AUTH_PASSWORD=
ABSULLI_AUTH_PASSWORD_HASH=
ABSULLI_AUTH_SESSION_MINUTES=720

# Set true only when accessing ABSulli over HTTPS.
ABSULLI_COOKIE_SECURE=false

# Optional bearer token for /api/* access when built-in auth is enabled.
ABSULLI_API_TOKEN=

# Optional CORS allowlist.
# Leave blank for no CORS headers / same-origin only.
# Example: ABSULLI_CORS_ALLOWED_ORIGINS=https://absulli.example.com,https://dashboard.example.com
ABSULLI_CORS_ALLOWED_ORIGINS=
ABSULLI_CORS_ALLOW_CREDENTIALS=false
ABSULLI_CORS_ALLOWED_METHODS=GET,POST,OPTIONS
ABSULLI_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Absulli-Api-Token,X-Absulli-Metrics-Token,X-CSRF-Token